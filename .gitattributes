# Normalize line endings for text files
* text=auto

# Unity YAML assets: treat as text, merge with UnityYAMLMerge if configured
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text eol=lf

# Code
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.json      text
*.md        text

# Large binary source files -> Git LFS
# (GitHub free LFS quota is small: only big source files go here, not every PNG)
*.psd       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.aif       filter=lfs diff=lfs merge=lfs -text
*.flac      filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text
*.ttf       filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text

# Small binaries: regular git, but never diff/merge
*.png       binary
*.jpg       binary
*.ogg       binary
*.mp3       binary

# Baked Unity data is binary even though it uses .asset — never convert line endings
**/LightingData.asset -text binary
**/NavMesh*.asset -text binary
*.exr binary

# Scripts for the Linux server (docs/DEPLOY.md)
*.sh        text eol=lf
deploy/**   text eol=lf
.github/**  text eol=lf
