    eventLines: []
    consequences: []
    questionTitle: JOIN THE RESISTANCE?
    questionBody: '"We need someone at this counter. Nobody has to know. Say yes,
      and when this is over, you and your family go free."'
    acceptLabel: JOIN
    declineLabel: REFUSE
    acceptLine: Welcome, comrade. We'll be in touch. Now stamp me through, as if
      nothing happened.
    declineLine: A pity. Forget we ever talked, officer.
