      note: 
  - rules: {fileID: 11400000, guid: 47b425f108c80aa4ab0cf080ce8cb42e, type: 2}
    letterTitle: A letter from home
    letter: "Dad,\nThe rent man came by. Mom gave him what we had. Pip has a cough
      but it is not bad.\nPlease send a little more this week if you can.\n\u2014
      Lena\n\n(placeholder text \u2013 P15)"
    newToday: 'New today: check the cargo manifest against the ID.'
